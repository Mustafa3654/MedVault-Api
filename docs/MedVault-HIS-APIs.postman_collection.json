            "pm.test('response is a PDF', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/pdf'));"
          ]
        }
      }],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{host}}/api/mobile/file?path={{pdfPath}}&tcToken={{token}}",
          "host": ["{{host}}"],
          "path": ["api", "mobile", "file"],
          "query": [
            { "key": "path", "value": "{{pdfPath}}" },
            { "key": "tcToken", "value": "{{token}}" }
          ]
        },
        "description": "API 6 — Downloads the PDF selected by API 4. Send API 1 (Login), API 4 (Radiology Studies), then this request."
      },
      "response": []
    }
