    {
      "name": "4. Radiology Studies — find PDF path",
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('studies is an array', () => pm.expect(b.studies).to.be.an('array'));",
            "const s = (b.studies || []).find(x => x.pdf_path);",
            "pm.test('at least one radiology PDF is available', () => pm.expect(s, 'No study has a pdf_path. Check Files:Root access and that a PDF filename starts with the study number.').to.exist);",
            "if (s) { pm.collectionVariables.set('studyNb', s.study_nb); pm.collectionVariables.set('pdfPath', s.pdf_path); }"
          ]
        }
      }],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{host}}/api/mobile/radiology?tcToken={{token}}",
          "host": ["{{host}}"],
          "path": ["api", "mobile", "radiology"],
          "query": [{ "key": "tcToken", "value": "{{token}}" }]
        },
        "description": "API 4 — Returns radiology studies. The test stores the first study with a PDF in studyNb and pdfPath for the next request."
      },
      "response": []
    },
